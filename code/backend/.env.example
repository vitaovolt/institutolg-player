APP_NAME="Instituto LG Biblioteca"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Produção: APP_URL e FRONTEND_URL = https://mesmo-dominio (CORS + mídia do player).
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=institutolg_player
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Produção: database + systemd institutolg-player-queue (fila biblioteca, 24 h).
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MVP não envia e-mail transacional — manter log no piloto (não ligar SES).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

SANCTUM_STATEFUL_DOMAINS=
VITE_APP_NAME="${APP_NAME}"

# local = disco do PC. Produção: s3 (ver docs/ARMAZENAMENTO.md). Nunca na UI.
BIBLIOTECA_AULAS_DRIVER=local
BIBLIOTECA_DISK_AULAS=aulas

BIBLIOTECA_DRIVE_FAKE=true
BIBLIOTECA_DRIVE_UPLOAD_URL=
BIBLIOTECA_DRIVE_TOKEN=
BIBLIOTECA_DRIVE_SERVICE_ACCOUNT_PATH=
BIBLIOTECA_DRIVE_FOLDER_ID=
BIBLIOTECA_DRIVE_TIMEOUT=15
BIBLIOTECA_PLAY_TTL_MINUTOS=360
